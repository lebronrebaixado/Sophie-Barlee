{% assign has_collections = false %}
{% for block in section.blocks %}{% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}{% assign has_collections = true %}{% endif %}{% endfor %}
{% assign eyebrow_key = 'home.collections.eyebrow' %}
{% assign title_key = 'home.collections.title' %}
{% case section.settings.heading_variant %}
  {% when 'featured' %}
    {% assign eyebrow_key = 'home.featured_collections.eyebrow' %}
    {% assign title_key = 'home.featured_collections.title' %}
  {% when 'trending' %}
    {% assign eyebrow_key = 'home.trending.eyebrow' %}
    {% assign title_key = 'home.trending.title' %}
{% endcase %}
{% if has_collections %}
  <section class="section collection-section" aria-labelledby="CollectionCardsTitle-{{ section.id }}">
    <div class="section-heading"><p class="eyebrow">{% render 'localized-copy', value: section.settings.eyebrow, translation_key: eyebrow_key %}</p><h2 id="CollectionCardsTitle-{{ section.id }}">{% render 'localized-copy', value: section.settings.title, translation_key: title_key %}</h2></div>
    <div class="collection-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% if collection != blank and collection.products_count > 0 %}
          {% assign card_image = block.settings.image | default: collection.featured_image | default: collection.products.first.featured_media.preview_image %}
          <a class="collection-card" href="{{ collection.url }}" {{ block.shopify_attributes }}>
            <div class="collection-image">
              {% if card_image != blank %}{{ card_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 900px) 20vw, 70vw', alt: block.settings.image_alt | default: collection.title }}{% endif %}
              <span class="collection-index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            </div>
            <h3>{{ block.settings.title | default: collection.title | escape }}</h3>
            {% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}
            <span class="text-link">{% render 'localized-copy', value: section.settings.link_label, translation_key: 'home.collections.link' %} <span aria-hidden="true">↗</span></span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Editorial collections",
  "max_blocks": 5,
  "settings": [
    { "type": "select", "id": "heading_variant", "label": "Heading style", "options": [
      { "value": "collections", "label": "Discover collections" },
      { "value": "featured", "label": "Featured collections" },
      { "value": "trending", "label": "In focus" }
    ], "default": "collections" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow override (optional)", "default": "" },
    { "type": "text", "id": "title", "label": "Title override (optional)", "default": "" },
    { "type": "text", "id": "link_label", "label": "Link label override (optional)", "default": "" }
  ],
  "blocks": [
    { "type": "collection", "name": "Shopify collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Optional editorial image" },
      { "type": "text", "id": "image_alt", "label": "Image alt text" },
      { "type": "text", "id": "title", "label": "Optional title" },
      { "type": "textarea", "id": "description", "label": "Optional description" }
    ] }
  ],
  "presets": [{ "name": "Editorial collections", "blocks": [] }]
}
{% endschema %}