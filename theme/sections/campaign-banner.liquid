{% assign campaign_alt = section.settings.image_alt %}
{% if campaign_alt == blank %}{% assign campaign_alt = 'home.campaign.image_alt' | t %}{% endif %}
<section class="campaign" aria-labelledby="CampaignTitle-{{ section.id }}">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'campaign-image', loading: 'lazy', widths: '900, 1200, 1600, 2000, 2400', sizes: '100vw', alt: campaign_alt }}
  {% else %}
    <img class="campaign-image" src="{{ 'sophie-campaign.webp' | asset_url }}" alt="{{ campaign_alt | escape }}" loading="lazy">
  {% endif %}
  <div class="campaign-shade"></div>
  <div class="campaign-copy">
    <p class="eyebrow">{% render 'localized-copy', value: section.settings.eyebrow, translation_key: 'home.campaign.eyebrow' %}</p>
    <h2 id="CampaignTitle-{{ section.id }}">{% render 'localized-copy', value: section.settings.title, translation_key: 'home.campaign.title' %}</h2>
    <p>{% render 'localized-copy', value: section.settings.subtitle, translation_key: 'home.campaign.subtitle' %}</p>
    {% assign campaign_url = section.settings.link %}
    {% if section.settings.collection != blank %}{% assign campaign_url = section.settings.collection.url %}{% endif %}
    <a class="button button-light" href="{{ campaign_url | default: routes.all_products_collection_url }}">{% render 'localized-copy', value: section.settings.button_label, translation_key: 'home.campaign.button' %} <span aria-hidden="true">↗</span></a>
  </div>
</section>

{% schema %}
{
  "name": "Panoramic campaign",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Campaign image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text override (optional)", "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow override (optional)", "default": "" },
    { "type": "text", "id": "title", "label": "Title override (optional)", "default": "" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle override (optional)", "default": "" },
    { "type": "text", "id": "button_label", "label": "Button label override (optional)", "default": "" },
    { "type": "collection", "id": "collection", "label": "Destination collection" },
    { "type": "url", "id": "link", "label": "Alternative link" }
  ],
  "presets": [{ "name": "Panoramic campaign" }]
}
{% endschema %}
