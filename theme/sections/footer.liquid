<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-wordmark" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
      <p>{% render 'localized-copy', value: section.settings.description, translation_key: 'footer.description' %}</p>
      {% if settings.contact_email != blank %}<a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>{% endif %}
    </div>
    {% if settings.footer_menu != blank %}
      <nav class="footer-nav" aria-label="{{ 'footer.support_navigation' | t | escape }}"><h2>{% render 'localized-copy', value: section.settings.menu_heading, translation_key: 'footer.menu_heading' %}</h2><ul>{% for link in settings.footer_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></nav>
    {% endif %}
    <nav class="footer-policies" aria-label="{{ 'footer.policies_navigation' | t | escape }}">
      {% if shop.policies.shipping_policy != blank %}<a href="{{ shop.policies.shipping_policy.url }}">{{ shop.policies.shipping_policy.title | escape }}</a>{% endif %}
      {% if shop.policies.refund_policy != blank %}<a href="{{ shop.policies.refund_policy.url }}">{{ shop.policies.refund_policy.title | escape }}</a>{% endif %}
      {% if shop.policies.privacy_policy != blank %}<a href="{{ shop.policies.privacy_policy.url }}">{{ shop.policies.privacy_policy.title | escape }}</a>{% endif %}
      {% if shop.policies.terms_of_service != blank %}<a href="{{ shop.policies.terms_of_service.url }}">{{ shop.policies.terms_of_service.title | escape }}</a>{% endif %}
    </nav>
  </div>
  <div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{% render 'localized-copy', value: section.settings.signature, translation_key: 'footer.signature' %}</span></div>
</footer>

{% schema %}
{
  "name": "Sophie Barlee footer",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Brand description override (optional)", "default": "" },
    { "type": "text", "id": "menu_heading", "label": "Menu heading override (optional)", "default": "" },
    { "type": "text", "id": "signature", "label": "Signature override (optional)", "default": "" }
  ]
}
{% endschema %}