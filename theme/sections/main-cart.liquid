<section class="section cart-page">
  <header class="section-heading"><p class="eyebrow">Sophie Barlee</p><h1>{{ 'cart.title' | t }}</h1></header>
  {% if cart.item_count > 0 %}
    {% form 'cart', cart, id: 'CartForm' %}
      <div class="cart-lines">
        {% for item in cart.items %}
          <article class="cart-line">
            <a class="cart-line-image" href="{{ item.url }}">{% if item.image != blank %}{{ item.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 240, 360, 480', alt: item.image.alt | default: item.product.title }}{% endif %}</a>
            <div class="cart-line-info"><a href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<span>{{ item.final_price | money }}</span></div>
            <label class="quantity-label" for="Quantity-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label><input id="Quantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
            <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="remove-link">{{ 'cart.remove' | t }}</a><span class="line-total">{{ item.final_line_price | money }}</span>
          </article>
        {% endfor %}
      </div>
      <div class="cart-summary"><p><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p><p class="cart-note">{{ 'cart.shipping_tax_note' | t }}</p><button type="submit" name="update" class="button button-outline">{{ 'cart.update' | t }}</button><button type="submit" name="checkout" class="button button-dark">{{ 'cart.checkout' | t }}</button></div>
    {% endform %}
  {% else %}
    <div class="catalog-empty"><h2>{{ 'cart.empty' | t }}</h2><a class="button button-dark" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a></div>
  {% endif %}
</section>

{% schema %}
{ "name": "Main cart", "settings": [] }
{% endschema %}