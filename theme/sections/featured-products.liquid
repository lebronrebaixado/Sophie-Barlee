<section class="section arrivals" aria-labelledby="ArrivalsTitle-{{ section.id }}">
  <div class="section-heading"><p class="eyebrow">{% render 'localized-copy', value: section.settings.eyebrow, translation_key: 'home.arrivals.eyebrow' %}</p><h2 id="ArrivalsTitle-{{ section.id }}">{% render 'localized-copy', value: section.settings.title, translation_key: 'home.arrivals.title' %}</h2></div>
  {% assign arrival_collection = section.settings.collection %}
  {% if arrival_collection != blank and arrival_collection.products_count > 0 %}
    <div class="product-grid">{% for product in arrival_collection.products limit: section.settings.product_limit %}{% render 'product-card', product: product %}{% endfor %}</div>
    <div class="section-action"><a class="text-link" href="{{ arrival_collection.url }}">{% render 'localized-copy', value: section.settings.button_label, translation_key: 'home.arrivals.view_all' %} <span aria-hidden="true">↗</span></a></div>
  {% else %}
    <div class="catalog-empty"><p class="eyebrow">Sophie Barlee</p><h3>{% render 'localized-copy', value: section.settings.empty_title, translation_key: 'home.arrivals.empty_title' %}</h3><p>{% render 'localized-copy', value: section.settings.empty_copy, translation_key: 'home.arrivals.empty_copy' %}</p></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "New arrivals",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow override (optional)", "default": "" },
    { "type": "text", "id": "title", "label": "Title override (optional)", "default": "" },
    { "type": "collection", "id": "collection", "label": "New arrivals collection" },
    { "type": "range", "id": "product_limit", "label": "Maximum products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label override (optional)", "default": "" },
    { "type": "text", "id": "empty_title", "label": "Empty-state title override (optional)", "default": "" },
    { "type": "textarea", "id": "empty_copy", "label": "Empty-state copy override (optional)", "default": "" }
  ],
  "presets": [{ "name": "New arrivals" }]
}
{% endschema %}