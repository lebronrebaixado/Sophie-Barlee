<section class="section arrivals" aria-labelledby="ArrivalsTitle-{{ section.id }}">
  <div class="section-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="ArrivalsTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2></div>
  {% assign arrival_collection = section.settings.collection %}
  {% if arrival_collection != blank and arrival_collection.products_count > 0 %}
    <div class="product-grid">{% for product in arrival_collection.products limit: section.settings.product_limit %}{% render 'product-card', product: product %}{% endfor %}</div>
    <div class="section-action"><a class="text-link" href="{{ arrival_collection.url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a></div>
  {% else %}
    <div class="catalog-empty"><p class="eyebrow">Sophie Barlee</p><h3>{{ section.settings.empty_title | escape }}</h3><p>{{ section.settings.empty_copy | escape }}</p></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Novas chegadas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Linha editorial", "default": "Descobre primeiro" },
    { "type": "text", "id": "title", "label": "Título", "default": "Novas chegadas" },
    { "type": "collection", "id": "collection", "label": "Coleção de novidades" },
    { "type": "range", "id": "product_limit", "label": "Número máximo de artigos", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Ver todas as novidades" },
    { "type": "text", "id": "empty_title", "label": "Título quando vazio", "default": "Ainda não há artigos disponíveis." },
    { "type": "textarea", "id": "empty_copy", "label": "Texto quando vazio", "default": "As novidades aparecem aqui quando os artigos estiverem disponíveis na loja." }
  ],
  "presets": [{ "name": "Novas chegadas" }]
}
{% endschema %}
