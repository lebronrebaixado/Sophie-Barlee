{% if section.settings.message != blank %}
  <div class="announcement-bar" role="status">
    {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
      <p>{{ section.settings.message | escape }}</p>
    {% if section.settings.link != blank %}</a>{% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Barra de anúncio",
  "settings": [
    { "type": "text", "id": "message", "label": "Mensagem", "default": "Descobre a nova coleção Sophie Barlee." },
    { "type": "url", "id": "link", "label": "Ligação opcional" }
  ],
  "presets": [{ "name": "Barra de anúncio" }]
}
{% endschema %}
