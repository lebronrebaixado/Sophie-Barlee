<div class="announcement-bar" role="status">
  {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
    <p>{% render 'localized-copy', value: section.settings.message, translation_key: 'home.announcement' %}</p>
  {% if section.settings.link != blank %}</a>{% endif %}
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "message", "label": "Message override (optional)", "default": "" },
    { "type": "url", "id": "link", "label": "Optional link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}